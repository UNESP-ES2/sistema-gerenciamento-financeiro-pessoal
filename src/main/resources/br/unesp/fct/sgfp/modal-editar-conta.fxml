<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" stylesheets="@css/theme.css" prefWidth="480.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.unesp.fct.sgfp.view.TelaEditarContaBancaria">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <!-- Header do Modal (CUE 3.1.3 - Editar Conta Bancária) -->
    <VBox spacing="4.0" styleClass="card-header">
        <Label text="Editar Conta Bancária" styleClass="title-medium" />
        <Label text="Atualize os dados e saldo da conta selecionada" styleClass="subtitle" wrapText="true" />
    </VBox>

    <!-- Formulário -->
    <VBox spacing="12.0">
        <VBox spacing="6.0">
            <Label text="Nome da Conta (Identificador Cadastral)" styleClass="text-label" />
            <TextField fx:id="campoNome" editable="false" disable="true" style="-fx-opacity: 0.85;" />
        </VBox>

        <HBox spacing="12.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label text="Modalidade da Conta" styleClass="text-label" />
                <ComboBox fx:id="comboTipo" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label text="Saldo Atual (R$)" styleClass="text-label" />
                <TextField fx:id="campoSaldo" promptText="0,00" />
            </VBox>
        </HBox>

        <VBox spacing="6.0">
            <Label text="Data de Referência (dd/MM/yyyy)" styleClass="text-label" />
            <DatePicker fx:id="pickerData" maxWidth="Infinity" />
        </VBox>

        <!-- Seção de Dados Bancários (oculta automaticamente para Carteira de Dinheiro - RN02) -->
        <VBox fx:id="boxDadosBancarios" spacing="12.0" style="-fx-background-color: #FAF5FF; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #E9D8FD; -fx-border-radius: 8px;">
            <Label text="Dados da Instituição Bancária" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B46C1;" />

            <VBox spacing="6.0">
                <Label text="Nome do Banco" styleClass="text-label" />
                <TextField fx:id="campoBanco" promptText="Ex: Banco do Brasil, Inter, Nubank" />
            </VBox>

            <HBox spacing="12.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Número da Agência" styleClass="text-label" />
                    <TextField fx:id="campoAgencia" promptText="Ex: 1" />
                </VBox>

                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Número da Conta" styleClass="text-label" />
                    <TextField fx:id="campoNumeroConta" promptText="Ex: 123456" />
                </VBox>
            </HBox>
        </VBox>
    </VBox>

    <!-- Feedback de Erro / Sucesso (RNF5.3) -->
    <Label fx:id="labelErro" wrapText="true" maxWidth="Infinity" />

    <!-- Botões de Ação -->
    <HBox spacing="12.0" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#botaoCancelar" styleClass="btn-secondary" />
        <Button text="Salvar Alterações" onAction="#botaoSalvar" styleClass="btn-primary" />
    </HBox>
</VBox>
